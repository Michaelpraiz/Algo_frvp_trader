# =============================================================================
# MT5 MCP SERVER — ENVIRONMENT CONFIG
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# -----------------------------------------------------------------------------
# MT5 CONNECTION
# -----------------------------------------------------------------------------
MT5_LOGIN=12345678                  # Your MT5 account number
MT5_PASSWORD=your_password_here     # Your MT5 account password
MT5_SERVER=YourBroker-Demo          # Broker server name (find in MT5 login screen)

# -----------------------------------------------------------------------------
# ACCOUNT MODE — CRITICAL
# -----------------------------------------------------------------------------
# Set to 'demo' until you have completed all Phase 9 validation checks.
# Only change to 'live' when ready.
ACCOUNT_TYPE=demo                   # Options: 'demo' | 'live'

# -----------------------------------------------------------------------------
# NEWS FILTER (optional but recommended)
# -----------------------------------------------------------------------------
# Free API key from https://forexfactory.com or https://financialmodelingprep.com
NEWS_API_KEY=your_news_api_key_here

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                      # Options: DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/mt5_mcp.log
